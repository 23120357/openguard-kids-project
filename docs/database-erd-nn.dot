digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.5, nodesep=0.65, ranksep=2.1, splines=polyline, outputorder=edgesfirst, dpi=170, fontname="Arial", fontsize=25, labelloc=t, label="OPENGUARD KIDS — THIẾT KẾ CSDL N–N\n11 bảng • 16 liên kết FK → PK\n "];
node [shape=plain, fontname="Arial"];
edge [arrowsize=0.8, penwidth=1.5];
parents [label=<<TABLE BORDER="1" COLOR="#b45309" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#b45309"><FONT COLOR="white" POINT-SIZE="19"><B>parents</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><B>email</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">UNIQUE</FONT></TD></TR><TR><TD PORT="password_hash" ALIGN="LEFT"><B>password_hash</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
children [label=<<TABLE BORDER="1" COLOR="#087f8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#087f8c"><FONT COLOR="white" POINT-SIZE="19"><B>children</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="display_name" ALIGN="LEFT"><B>display_name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="pin_hash" ALIGN="LEFT"><B>pin_hash</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
devices [label=<<TABLE BORDER="1" COLOR="#7048b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#7048b8"><FONT COLOR="white" POINT-SIZE="19"><B>devices</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="display_name" ALIGN="LEFT"><B>display_name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="fingerprint" ALIGN="LEFT"><B>fingerprint</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="active_child_id" ALIGN="LEFT"><B>active_child_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK, NULL</FONT></TD></TR><TR><TD PORT="used_seconds" ALIGN="LEFT"><B>used_seconds</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="remaining_seconds" ALIGN="LEFT"><B>remaining_seconds</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
parent_children [label=<<TABLE BORDER="1" COLOR="#23435c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#23435c"><FONT COLOR="white" POINT-SIZE="19"><B>parent_children</B></FONT></TD></TR><TR><TD PORT="parent_id" ALIGN="LEFT"><B>parent_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK, FK</FONT></TD></TR><TR><TD PORT="child_id" ALIGN="LEFT"><B>child_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK, FK</FONT></TD></TR></TABLE>>];
child_devices [label=<<TABLE BORDER="1" COLOR="#23435c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#23435c"><FONT COLOR="white" POINT-SIZE="19"><B>child_devices</B></FONT></TD></TR><TR><TD PORT="child_id" ALIGN="LEFT"><B>child_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK, FK</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT"><B>device_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK, FK</FONT></TD></TR></TABLE>>];
parent_sessions [label=<<TABLE BORDER="1" COLOR="#23435c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#23435c"><FONT COLOR="white" POINT-SIZE="19"><B>parent_sessions</B></FONT></TD></TR><TR><TD PORT="token_hash" ALIGN="LEFT"><B>token_hash</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="parent_id" ALIGN="LEFT"><B>parent_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="csrf_token" ALIGN="LEFT"><B>csrf_token</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="expires_at" ALIGN="LEFT"><B>expires_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
