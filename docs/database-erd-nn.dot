enrollment_codes [label=<<TABLE BORDER="1" COLOR="#23435c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#23435c"><FONT COLOR="white" POINT-SIZE="19"><B>enrollment_codes</B></FONT></TD></TR><TR><TD PORT="code_hash" ALIGN="LEFT"><B>code_hash</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="child_id" ALIGN="LEFT"><B>child_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="expires_at" ALIGN="LEFT"><B>expires_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
audit [label=<<TABLE BORDER="1" COLOR="#23435c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#23435c"><FONT COLOR="white" POINT-SIZE="19"><B>audit</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="parent_id" ALIGN="LEFT"><B>parent_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="child_id" ALIGN="LEFT"><B>child_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="action" ALIGN="LEFT"><B>action</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="ts" ALIGN="LEFT"><B>ts</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
device_commands [label=<<TABLE BORDER="1" COLOR="#23435c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#23435c"><FONT COLOR="white" POINT-SIZE="19"><B>device_commands</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT"><B>device_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="child_id" ALIGN="LEFT"><B>child_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="parent_id" ALIGN="LEFT"><B>parent_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="command_type" ALIGN="LEFT"><B>command_type</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><B>status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
time_requests [label=<<TABLE BORDER="1" COLOR="#23435c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD COLSPAN="2" BGCOLOR="#23435c"><FONT COLOR="white" POINT-SIZE="19"><B>time_requests</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">PK</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT"><B>device_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="child_id" ALIGN="LEFT"><B>child_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK</FONT></TD></TR><TR><TD PORT="decided_by" ALIGN="LEFT"><B>decided_by</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">FK, NULL</FONT></TD></TR><TR><TD PORT="minutes" ALIGN="LEFT"><B>minutes</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><B>status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#536273">&#160;</FONT></TD></TR></TABLE>>];
parents:id:e -> parent_children:parent_id:w [dir=back, arrowtail=normal, color="#b45309", style=solid];
children:id:e -> parent_children:child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=solid];
children:id:e -> child_devices:child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=solid];
devices:id:e -> child_devices:device_id:w [dir=back, arrowtail=normal, color="#7048b8", style=solid];
children:id:e -> devices:active_child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=dashed];
parents:id:e -> parent_sessions:parent_id:w [dir=back, arrowtail=normal, color="#b45309", style=solid];
children:id:e -> policies:child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=solid];
children:id:e -> enrollment_codes:child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=solid];
parents:id:e -> audit:parent_id:w [dir=back, arrowtail=normal, color="#b45309", style=solid];
children:id:e -> audit:child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=solid];
devices:id:e -> device_commands:device_id:w [dir=back, arrowtail=normal, color="#7048b8", style=solid];
children:id:e -> device_commands:child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=solid];
parents:id:e -> device_commands:parent_id:w [dir=back, arrowtail=normal, color="#b45309", style=solid];
devices:id:e -> time_requests:device_id:w [dir=back, arrowtail=normal, color="#7048b8", style=solid];
children:id:e -> time_requests:child_id:w [dir=back, arrowtail=normal, color="#087f8c", style=solid];
parents:id:e -> time_requests:decided_by:w [dir=back, arrowtail=normal, color="#b45309", style=dashed];
{rank=same; parents; children;}
{rank=same; parent_children; devices; parent_sessions; policies; enrollment_codes;}
{rank=same; child_devices; audit; device_commands; time_requests;}
notes [label=<<TABLE BORDER="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B>Thiết kế đề xuất — chưa thay đổi mã nguồn</B></TD></TR><TR><TD ALIGN="LEFT">parents N–N children qua parent_children</TD></TR><TR><TD ALIGN="LEFT">children N–N devices qua child_devices</TD></TR><TR><TD ALIGN="LEFT">Hai bảng trung gian dùng khóa chính ghép gồm cả hai FK.</TD></TR><TR><TD ALIGN="LEFT">Mũi tên: FK → PK. Nét đứt: FK cho phép NULL.</TD></TR><TR><TD ALIGN="LEFT">active_child_id chỉ xác định hồ sơ đang sử dụng thiết bị.</TD></TR><TR><TD ALIGN="LEFT">Các trường phụ được rút gọn; giữ đầy đủ các FK của mô hình.</TD></TR></TABLE>>];
}