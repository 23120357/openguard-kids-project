  "components": {
    "schemas": {
      "ActivityPayload": {
        "properties": {
          "ts": {
            "type": "number",
            "minimum": 0.0,
            "title": "Ts"
          },
          "device_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Device Id"
          },
          "child_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Child Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "app_start",
              "app_stop",
              "domain_query",
              "blocked_app",
              "blocked_domain",
              "quota_warning",
              "locked",
              "unlock_request",
              "override_granted"
            ],
            "title": "Type"
          },
          "subject": {
            "type": "string",
            "maxLength": 253,
            "minLength": 1,
            "title": "Subject"
          },
          "duration_sec": {
            "type": "integer",
